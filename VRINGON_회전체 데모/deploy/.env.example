# deploy/.env 로 복사해서 값을 채운다. 이 파일은 저장소에 올리지 않는다(.gitignore).
# 판독 AI (역할명만 쓴다. 실제 공급사·모델명은 여기에만 있다)
VRINGON_PRIMARY_URL=
VRINGON_PRIMARY_KEY=
VRINGON_PRIMARY_TEXT_MODEL=
VRINGON_PRIMARY_PLAN_MODEL=
# 예비 경로 (없으면 비워 둔다)
VRINGON_FALLBACK_URL=
VRINGON_FALLBACK_KEY=
VRINGON_FALLBACK_TEXT_MODEL=

# 링크를 아는 사람 중에서도 코드를 가진 사람만 들어오게 (비우면 완전 공개)
VRINGON_ACCESS_CODE=

# 판독 호출은 건당 비용이 든다: 접속 주소당 시간 제한 (0 이면 무제한)
VRINGON_RATE_PER_HOUR=30

# 브라우저에 내보낼 정적 폴더 (보호 빌드)
VRINGON_STATIC=../docs/revolve
