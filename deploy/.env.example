# deploy/.env 로 복사해서 채운다. 이 파일(.env)은 저장소에 올리지 않는다(.gitignore).
# Copy to deploy/.env and fill in. The .env itself is never committed (.gitignore).
#
# 값은 전부 서버 환경변수로만 산다. 브라우저에는 어떤 것도 내려가지 않는다.
# Every value lives only in the server environment; nothing reaches the browser.

# ---------- 로그인 / login (guard.mjs) ----------
# 데모 계정 (쉼표). 비우면 Test1..Test20,dsht / demo accounts; default Test1..Test20,dsht
VRINGON_DEMO_USERS=
# 비밀번호: 평문 하나 또는 sha256 하나. 둘 다 비우면 예전 데모 비밀번호로 돌아간다(경고가 찍힌다)
# Password: plaintext or its sha256. With both empty the legacy demo password applies (and a warning is logged)
VRINGON_DEMO_PASSWORD=
VRINGON_DEMO_PASSWORD_SHA256=
# 세션 서명 키. 비우면 프로세스마다 새로 만들어져 재시작하면 모두 다시 로그인한다
# Session signing key. Left empty, a fresh one is made per process and a restart logs everyone out
#   만들기 / generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VRINGON_SESSION_SECRET=
# 주소당 시간당 비용 호출 한도 (0 이면 무제한) / costly calls per address per hour, 0 = unlimited
VRINGON_RATE_PER_HOUR=120

# ---------- 드론 서버의 외부 AI / external AI for the drone server (server.mjs) ----------
# 역할명만 쓴다. 실제 공급사·모델명은 여기에만 있다 / role names only; vendor and model names live only here
PRIMARY_LLM_URL=
PRIMARY_LLM_API_KEY=
PRIMARY_TEXT_MODEL=
PRIMARY_PLAN_MODEL=
PRIMARY_IMAGE_MODEL=
FALLBACK_LLM_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_TEXT_MODEL=
FALLBACK_PLAN_MODEL=
FALLBACK_IMAGE_MODEL=
# 메시 생성 클라우드 (있으면) / mesh generation cloud, if any
MESH_CLOUD_URL=
MESH_CLOUD_API_KEY=

# ---------- 회전체 서버의 외부 AI / external AI for the turned-part server (VRINGON_회전체 데모/server.mjs) ----------
VRINGON_PRIMARY_URL=
VRINGON_PRIMARY_KEY=
VRINGON_PRIMARY_TEXT_MODEL=
VRINGON_PRIMARY_PLAN_MODEL=
VRINGON_FALLBACK_URL=
VRINGON_FALLBACK_KEY=
VRINGON_FALLBACK_TEXT_MODEL=
VRINGON_STATIC=../docs/revolve
